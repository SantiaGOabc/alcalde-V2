---
import { Section, Tipography } from "@components";
import { SmartImage } from "@components";

interface Props {
	title: string;
	description: string;
	images?: string[];
	id?: string;
}

const { title, description, images: allImages = [], id } = Astro.props;

// Las imágenes sin URL no forman parte del carrusel.
const images = allImages.filter(Boolean);
---

<Section
	className="home-hero relative isolate grid min-h-svh place-items-center overflow-hidden text-center text-white"
	id={id}
>
	{
		images.length > 0 && (
			<div
				class="hero-media"
				aria-hidden="true"
				style={`--hero-count: ${images.length}`}
			>
				{images.map((src, index) => (
					<SmartImage
						src={src}
						alt=""
						width={1920}
						height={1080}
						loading={index === 0 ? "eager" : "lazy"}
						decoding="async"
						class="hero-media__layer"
						style={`--i: ${index}`}
					/>
				))}
			</div>
		)
	}

	<div class="hero-veil" aria-hidden="true"></div>

	<div class="hero-foco" aria-hidden="true"></div>

	<div class="hero-texto relative z-20 mx-auto max-w-5xl">
		<Tipography
			as="p"
			variant="body"
			color="inherit"
			class="text-sm font-semibold uppercase tracking-widest text-white/80"
		>
			{title}
		</Tipography>

		<Tipography
			as="h1"
			variant="h1"
			color="inherit"
			class="mt-5 uppercase text-white"
		>
			{description}
		</Tipography>
	</div>
</Section>