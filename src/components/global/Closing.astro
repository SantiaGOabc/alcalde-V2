---
import { ButtonAstro, Section, Tipography } from "@components";
import type { ClosingContent } from "@types";

interface Props {
  content: ClosingContent;
}

const { phrase, enphasis, description, primary } = Astro.props.content;
---

<Section className="py-24 sm:py-32 lg:py-40">
  <div data-reveal class="page-container mx-auto max-w-4xl text-center">
    <Tipography as="blockquote" variant="quote" class="m-0 text-3xl leading-tight text-balance sm:text-5xl lg:text-6xl">
      {phrase} { " " } <span class="text-primary">{enphasis}</span>
    </Tipography>
    <Tipography variant="lead" color="muted" class="mx-auto mt-8 max-w-xl text-basesm:text-lg">
      {description}
    </Tipography>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <ButtonAstro
        href={primary.href}
        size="lg"
        variant= "primary"
        class="text-(--brand-secondary) hover:bg-(--home-primary)/30 hover:brightness-100"
      >
        {primary.label}
      </ButtonAstro>
    </div>
  </div>
</Section>
