---
import { Section, Tipography, SafeImage } from "@components";
import type { CmsContent } from "@/cms/sections";

interface Props {
  content: CmsContent<"about.person">;
}

const { kicker, title, imageURL, imageAlt, imageCaption, paragraphs, likesTitle, likes } =
  Astro.props.content;
---

<Section variant="primary" className="py-20 sm:py-28 lg:py-36">
  <div class="page-container grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
    <figure data-reveal class="relative m-0 mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <div
        aria-hidden="true"
        class="absolute -right-3 -bottom-3 size-full rounded-3xl bg-(--home-accent) sm:-right-5 sm:-bottom-5"
      >
      </div>
      <SafeImage
        src={imageURL}
        alt={imageAlt}
        width={900}
        height={1125}
        class="relative aspect-4/5 w-full rounded-3xl object-cover object-top"
      />
      <Tipography as="figcaption" variant="eyebrow" color="muted" class="relative mt-8 tracking-[0.2em]">
        {imageCaption}
      </Tipography>
    </figure>

    <div class="lg:col-span-7">
      <div data-reveal>
        <Tipography variant="eyebrow" color="accent" class="mb-3">{kicker}</Tipography>
        <Tipography as="h2" variant="display">{title}</Tipography>
      </div>

      <div class="mt-8 space-y-5">
        {
          paragraphs.map((paragraph) => (
            <Tipography variant="lead" color="secondary" data-reveal>
              {paragraph}
            </Tipography>
          ))
        }
      </div>

      <div data-reveal class="mt-12">
        <Tipography variant="quote" class="text-2xl sm:text-2xl">{likesTitle}</Tipography>
        <ul class="mt-5 flex flex-wrap gap-3">
          {
            likes.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex rounded-full border-2 border-(--brand-primary)/30 px-5 py-2.5 text-sm font-semibold text-(--brand-primary) no-underline transition-colors hover:border-(--brand-primary) hover:bg-(--brand-primary) hover:text-white"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
