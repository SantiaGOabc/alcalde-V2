---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'accent';
interface Props extends HTMLAttributes<'section'> {
    variant?: Variant;
    className?: string;
}


const VARIANTS = {
    'primary': 'bg-gray-100 text-black',
    'secondary': 'bg-white text-black',
    'accent': 'bg-purple-700 text-white',

}

const {
    variant = 'primary',
    className,
    class: classProp,
    ...props
} = Astro.props;

const classes = [VARIANTS[variant], className, classProp]
    .filter(Boolean)
    .join(' ');
---

<section class={classes} {...props}>
    <slot />
</section>