---
import {Link} from "@components";
import { NAVBAR } from "@constant";

import "@styles/home.css";
const {isHome = false} = Astro.props;
---

<nav
  id="site-navbar"
  data-navbar-glass={isHome ? "true" : "false"}
  aria-label="Navegación principal"
  class:list={["fixed top-0 z-50 w-full",
    isHome ? "bg-transparent shadow-sm backdrop-blur-sm transition-all duration-300"
      : "bg-[var(--home-accent)] shadow-md"
  ]}
>
  <div class="page-container flex h-16 items-center justify-between">
    <a href="/" class="text-lg font-semibold no-underline before:hidden after:hidden">M.R.V</a>
    <ul class="flex items-center gap-6">
      {
        NAVBAR.map((nav) => (
          <li>
            <Link
              href={nav.path}
              aria-current={nav.path === Astro.url.pathname ? "page" : undefined}
              class="text-lg font-semibold text-gray-200 no-underline before:hidden after:hidden"
            >
              {nav.label}
            </Link>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const navbar = document.getElementById("site-navbar");
  if (navbar?.dataset.navbarGlass === "true") {
    const GLASS_BG = "bg-transparent";
    const SOLID_BG = "bg-[var(--home-accent)]";
    const SCROLL_THRESHOLD = 150;

    const updateNavbar = () => {
      const isScrolled = window.scrollY > SCROLL_THRESHOLD;
      navbar.classList.toggle(GLASS_BG, !isScrolled);
      navbar.classList.toggle(SOLID_BG, isScrolled);
      navbar.classList.toggle("shadow-sm", !isScrolled);
      navbar.classList.toggle("shadow-md", isScrolled);
    };

    updateNavbar();
    window.addEventListener("scroll", updateNavbar, { passive: true });
  }
</script>
