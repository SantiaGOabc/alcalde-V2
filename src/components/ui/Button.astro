---
const { text, href } = Astro.props;
---

<button className="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none">
	<span className="flex items-center gap-2">
		{text}
		<span>{text}</span>
	</span>
</button>