---
import { Section, SafeImage, Tipography } from "@components";

interface Props {
  phrase: string;
  imageURL: string;
  reverse?: boolean;
  variant?: "primary" | "secondary";
  /** La primera frase del slider entra desde la izquierda. */
  lead?: boolean;
  /** Posicion dentro del slider, en base 0. */
  index?: number;
}

const {
  phrase,
  imageURL,
  reverse = false,
  variant = "secondary",
  lead = false,
  index = 0,
} = Astro.props;
---

<Section
  variant={variant}
  class:list={[
    "phrase-item",
    lead && "phrase-item--lead",
    "py-24 lg:py-32",
  ]}
  style={`--index: ${index}`}
>
  <div
    class:list={[
      "phrase-item__content page-container grid items-center gap-14 lg:grid-cols-12 lg:gap-20",
    ]}
  >
    <div
      class:list={[
        "phrase-item__text lg:col-span-5",
        reverse && "lg:order-2",
      ]}
    >
      <blockquote class="m-0">
        <Tipography
          as="cite"
          variant="title"
          class="block font-(family-name:--font-italic) font-normal italic"
        >
          “{phrase}”
        </Tipography>
      </blockquote>
    </div>

    <figure
      class:list={[
        "phrase-item__figure relative m-0 aspect-4/3 w-full lg:col-span-7",
      ]}
    >
      <div
        aria-hidden="true"
        class:list={[
          "absolute bottom-0 left-1/2 aspect-square w-[64%] -translate-x-1/2 overflow-hidden rounded-full",
          variant === "primary" ? "bg-(--home-accent)" : "bg-gray-200",
        ]}
      >
        <SafeImage
          src={imageURL}
          alt={phrase}
          width={1400}
          height={1400}
          loading="lazy"
          class="size-full object-cover object-top"
        />
      </div>
    </figure>
  </div>
</Section>
