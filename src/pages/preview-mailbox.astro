import MailboxBoard from '../components/Sections/Admin/Dashboard/Mailbox/MailboxBoard.astro';

/**
 * Banco de pruebas del tablero: el componente real con mensajes inventados.
 *
 * No replica nada del tablero. Al pasarle `messages` y `standalone` no toca la base
 * ni espera a que `CmsPanel` destape la pestaña, así que filtros, arrastre, teclado,
 * modal y toasts se pueden probar con datos que no se borran al moverlos.
 *
 * Ojo: `preview-mailbox.astro` es una ruta pública y no pide sesión. No debe quedar
 * publicada; sirve mientras se toca la pantalla.
 */
