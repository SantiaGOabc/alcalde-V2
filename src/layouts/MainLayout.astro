---
import { Navbar, Footer } from "@components"
import '../styles/global.css';

interface Props {
	title: string;
	isHome?: boolean;
}

const { title, isHome: isHomeProp } = Astro.props;

// El Home es la unica seccion con efecto de cristal en el navbar. Si la
// pagina no lo dice explicitamente se deduce de la ruta, para que el navbar
// nunca se quede transparente en una seccion interior (ni cristal en el Home).
const isHome = isHomeProp ?? Astro.url.pathname.replace(/\/+$/, "") === "";
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content="Alcaldía V2" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<Navbar isHome={isHome} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
