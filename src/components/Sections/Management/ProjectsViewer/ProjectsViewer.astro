---
/**
 * Visor de Gestión — tarjeta violeta.
 *
 * La isla no necesita saber de dónde salen las obras: se las pasa ya
 * agrupadas por categoría y con las imágenes optimizadas, que es lo único que
 * hace `prepararCategorias`.
 *
 * Esta es la variante `tarjeta`. Cuál de las dos se pinta lo decide
 * `GESTION_VIEWER` (`@constants/management/viewer`); la editorial de
 * `../ProjectsViewerEditorial` usa el mismo extractor y las mismas props.
 */
import type { Obra } from '@constant';
import { prepararCategorias } from '../visorObrasData';
import { ProjectsViewer as ProjectsViewerIsland } from './index';

interface Props {
  /** Obras ya publicadas (de la base de datos o, en su defecto, de los constants). */
  obras: Obra[];
}

const { obras } = Astro.props;

const categorias = await prepararCategorias(obras);
---

<ProjectsViewerIsland client:visible categorias={categorias} />
