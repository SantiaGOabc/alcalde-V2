---
import { Image } from "astro:assets";
import { Button, Input, Section, Tipography } from "@components";
import { ArrowLeft, ArrowRight } from "@icons";

interface Props {
  title: string;
  description: string;
  before: Array<{
    title: string;
    imageURL: string;
    imageFit: "contain" | "cover";
  }>;
  after: Array<{
    title: string;
    imageURL: string;
    imageFit: "contain" | "cover";
  }>;
}

const { title, description, before, after } = Astro.props;
const slides = before.flatMap((beforeImage, index) =>
  after[index] ? [{ before: beforeImage, after: after[index] }] : [],
);
---

<Section className="py-24 sm:py-28 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <header class="mb-10 max-w-3xl sm:mb-14">
      <Tipography
        as="h2"
        class="mt-3 text-3xl font-semibold leading-tight text-balance sm:text-4xl lg:text-5xl"
      >
        {title}
      </Tipography>
      <Tipography
        as="p"
        class="mt-4 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg"
      >
        {description}
      </Tipography>
    </header>
    {
      slides.length > 0 && (
        <div
          class="overflow-hidden rounded-lg bg-(--home-accent) text-white shadow-xl"
          data-before-after-slider
        >
          <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <Button
              type="button"
              variant="inverse"
              className="size-14 shrink-0 border border-white/25 p-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-40"
              aria-label="Comparación anterior"
              title="Comparación anterior"
              data-previous-slide
            >
              <ArrowLeft />
            </Button>
            <Tipography
              as="p"
              color="inherit"
              class="m-0 text-sm font-medium tabular-nums text-white/75"
              aria-live="polite"
              data-slide-counter
            >
              01 / {String(slides.length).padStart(2, "0")}
            </Tipography>
            <Button
              type="button"
              variant="inverse"
              className="size-14 shrink-0 border border-white/25 p-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-40"
              aria-label="Siguiente comparación"
              title="Siguiente comparación"
              data-next-slide
            >
              <ArrowRight />
            </Button>
          </div>
          <div class="relative aspect-4/3 w-full overflow-hidden bg-(--home-accent) sm:aspect-video">
            {slides.map((slide, index) => (
              <div class="absolute inset-0" data-slide hidden={index !== 0}>
                <Image
                  src={slide.before.imageURL}
                  alt={`Antes: ${slide.before.title}`}
                  class={`absolute inset-0 size-full select-none ${slide.before.imageFit === "contain" ? "object-contain" : "object-cover"}`}
                  draggable="false"
                  width={slide.before.imageFit === "contain" ? 900 : 1400}
                  height={slide.before.imageFit === "contain" ? 1400 : 900}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <div
                  class="absolute inset-0 overflow-hidden"
                  data-after-layer
                  style="clip-path: inset(0 0 0 50%)"
                >
                  <Image
                    src={slide.after.imageURL}
                    alt={`Después: ${slide.after.title}`}
                    class={`absolute inset-0 size-full select-none ${slide.after.imageFit === "contain" ? "object-contain" : "object-cover"}`}
                    draggable="false"
                    width={slide.after.imageFit === "contain" ? 900 : 1400}
                    height={slide.after.imageFit === "contain" ? 1400 : 900}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-y-0 left-1/2 z-10 w-0.5 -translate-x-1/2 bg-white shadow-[0_0_12px_rgb(0_0_0/0.45)]"
                  data-divider
                >
                  <span class="absolute left-1/2 top-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/80 bg-(--home-accent) shadow-lg">
                    <ArrowRight />
                  </span>
                </div>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex justify-between bg-linear-to-t from-black/65 to-transparent px-4 pb-4 pt-12 sm:px-6 sm:pb-6">
                  <Tipography
                    as="span"
                    color="inherit"
                    class="rounded-sm bg-black/55 px-3 py-1.5 text-xs font-semibold uppercase text-white sm:text-sm"
                  >
                    Antes · {slide.before.title}
                  </Tipography>
                  <Tipography
                    as="span"
                    color="inherit"
                    class="rounded-sm bg-black/55 px-3 py-1.5 text-xs font-semibold uppercase text-white sm:text-sm"
                  >
                    Después · {slide.after.title}
                  </Tipography>
                </div>
              </div>
            ))}

            <Input
              type="range"
              min="0"
              max="100"
              value="50"
              aria-label="Comparar antes y después; usa las flechas izquierda y derecha para mover el divisor"
              aria-valuetext="50% después"
              class="absolute inset-x-0 top-1/2 z-20 h-10 w-full -translate-y-1/2 cursor-ew-resize opacity-0 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              data-comparison-range
            />
          </div>
        </div>
      )
    }
  </div>
</Section>

<script>
  import { $$ } from "@utils";
  $$("[data-before-after-slider]").forEach((sliderElement) => {
    const slider = sliderElement as HTMLElement;
    const slides = Array.from(
      slider.querySelectorAll("[data-slide]"),
    ) as HTMLElement[];
    const range = slider.querySelector(
      "[data-comparison-range]",
    ) as HTMLInputElement | null;
    const counter = slider.querySelector(
      "[data-slide-counter]",
    ) as HTMLElement | null;
    const previousButton = slider.querySelector(
      "[data-previous-slide]",
    ) as HTMLButtonElement | null;
    const nextButton = slider.querySelector(
      "[data-next-slide]",
    ) as HTMLButtonElement | null;

    if (
      !range ||
      !counter ||
      !previousButton ||
      !nextButton ||
      slides.length === 0
    )
      return;

    let activeIndex = 0;

    const updateComparison = () => {
      const value = Number(range.value);
      const activeSlide = slides[activeIndex];
      const afterLayer = activeSlide.querySelector(
        "[data-after-layer]",
      ) as HTMLElement | null;
      const divider = activeSlide.querySelector(
        "[data-divider]",
      ) as HTMLElement | null;

      afterLayer?.style.setProperty("clip-path", `inset(0 0 0 ${value}%)`);
      divider?.style.setProperty("left", `${value}%`);
      range.setAttribute("aria-valuetext", `${value}% después`);
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== activeIndex;
      });
      range.value = "50";
      counter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      updateComparison();
    };

    range.addEventListener("input", updateComparison);
    previousButton.addEventListener("click", () => showSlide(activeIndex - 1));
    nextButton.addEventListener("click", () => showSlide(activeIndex + 1));
    updateComparison();
  });
</script>
