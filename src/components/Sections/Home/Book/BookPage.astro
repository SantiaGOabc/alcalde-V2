---
import { Image } from "astro:assets";
import { Button, Tipography } from "@components";
import type { BookPage } from "@types";
import { BOOK_ATTR, BOOK_META } from "@constant";

interface Props extends BookPage {}

const { kind, label, kicker, body, caption, image, gallery, video, works } =
  Astro.props;

const reveal = { [BOOK_ATTR.reveal]: "" };
const expand = { [BOOK_ATTR.expand]: "" };
const labelAttr = { [BOOK_ATTR.label]: label };
---

{
  kind === "cover" && (
    <article {...labelAttr} class="book-page relative isolate flex h-full flex-col justify-end overflow-hidden rounded-sm bg-(--home-accent) p-7 text-white">
      <Image
        src={BOOK_META.coverImage}
        alt={BOOK_META.coverAlt}
        width={1024}
        height={1365}
        class="absolute inset-0 -z-10 size-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/35 to-black/45"
      />
    </article>
  )
}

{
  kind === "back" && (
    <article {...labelAttr} class="book-page relative isolate flex h-full flex-col items-center justify-center overflow-hidden rounded-sm bg-(--home-accent) p-7 text-center text-white">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-linear-to-br from-(--home-accent) via-(--home-accent-strong) to-(--home-accent)"
      />
      <header class="flex flex-col gap-3">
        <Tipography
          as="h3"
          color="inherit"
          {...reveal}
          class="text-[calc(1.6rem*var(--book-text-scale))] font-bold"
        >
          {BOOK_META.backTitle}
        </Tipography>
        <Tipography
          as="p"
          color="inherit"
          {...reveal}
          class="max-w-[28ch] text-[calc(0.95rem*var(--book-text-scale))] text-white/75"
        >
          {BOOK_META.backText}
        </Tipography>
      </header>
    </article>
  )
}

{
  /*
    Una hoja de papel del libro real es una foto a sangre con el título
    montado encima, no una ficha blanca con texto: por eso la imagen (o, si
    no hay ninguna todavía, el degradado de la marca) va de fondo a la página
    entera y el texto se apoya sobre ella, igual que en el PDF de origen. El
    velo de abajo es lo que hace que ese texto se lea encima de cualquier
    foto, clara u oscura.
  */
  kind === "page" && (
    <article {...labelAttr} class="book-page relative isolate flex h-full flex-col justify-end overflow-hidden rounded-sm text-white">
      {image && (
        <Image
          src={image.src}
          alt={image.alt}
          width={1000}
          height={1500}
          class="absolute inset-0 -z-20 size-full object-cover object-[50%_30%]"
          loading="lazy"
          decoding="async"
        />
      )}

      {!image && (
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-20 bg-linear-to-br from-(--home-accent) via-(--home-accent-strong) to-(--home-accent)"
        />
      )}

      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-linear-to-t from-black/92 via-black/45 to-black/10"
      />

      <div class="book-page__body relative flex h-full flex-col justify-end gap-3 overflow-y-auto overscroll-contain px-6 pt-7 pb-6">
        {kicker && (
          <Tipography
            as="p"
            color="inherit"
            {...reveal}
            class="text-[calc(0.68rem*var(--book-text-scale))] font-semibold tracking-[0.18em] text-white/80 uppercase"
          >
            {kicker}
          </Tipography>
        )}

        <Tipography
          as="h2"
          color="inherit"
          {...reveal}
          class="text-[calc(1.5rem*var(--book-text-scale))] leading-[1.1] font-extrabold"
        >
          {label}
        </Tipography>

        {body && (
          <Tipography
            as="p"
            color="inherit"
            {...reveal}
            class="text-[calc(0.88rem*var(--book-text-scale))] leading-[1.6] text-white/85"
          >
            {body}
          </Tipography>
        )}

        {gallery && (
          <div {...reveal} class="flex gap-2.5">
            {gallery.map((photo) => (
              <figure
                {...expand}
                class="min-w-0 flex-1 overflow-hidden rounded-lg border border-white/20"
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={720}
                  height={960}
                  class="aspect-3/4 size-full object-cover object-[50%_30%]"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        )}

        {video && (
          <Button
            type="button"
            variant="ghost"
            {...expand}
            {...{ [BOOK_ATTR.videoUrl]: video.src }}
            aria-label={`Ampliar video: ${video.alt}`}
            className="w-fit cursor-pointer rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[calc(0.8rem*var(--book-text-scale))] font-semibold text-white backdrop-blur-sm hover:bg-white/20"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5-11-6.5Z" />
            </svg>
            Ver video
          </Button>
        )}

        {caption && (
          <Tipography
            as="p"
            color="inherit"
            class="text-[calc(0.78rem*var(--book-text-scale))] text-white/60 italic"
          >
            {caption}
          </Tipography>
        )}

        {works && works.length > 0 && (
          <ul {...reveal} class="mt-1 flex flex-col gap-0.5 rounded-lg bg-black/35 px-3 py-2 backdrop-blur-sm">
            {works.map((work) => (
              <li class="flex items-baseline justify-between gap-3 border-b border-white/15 py-1.5 text-[calc(0.8rem*var(--book-text-scale))] leading-snug last:border-b-0">
                <span>{work.name}</span>
                {work.year && (
                  <em class="shrink-0 font-bold text-white not-italic">
                    {work.year}
                  </em>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  )
}
