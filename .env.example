# Copia este archivo a .env y ajusta los valores. .env NO se sube a git.

# PostgreSQL (docker-compose usa estos mismos valores para crear el servidor)
POSTGRES_USER=alcalde
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alcalde
# Conexion desde tu maquina (npm run dev / npm run db:setup).
# El contenedor publica el puerto 5434 para no chocar con un Postgres local.
DATABASE_URL=postgresql://alcalde:change-me@localhost:5434/alcalde

# Panel de administracion: se entra en /admin/<ADMIN_SECRET_CODE>
ADMIN_SECRET_CODE=change-me-long-random-code
# Solo para imprimir la URL del panel al terminar `npm run db:setup`
SITE_URL=http://localhost:4321
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Clave para firmar las sesiones (JWT), minimo 32 caracteres. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-min-32-characters-random
