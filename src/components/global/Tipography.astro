---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span' | 'small';
  variant?: 'h1' | 'h2' | 'h3' | 'body' | 'body-sm' | 'muted';
  color?: 'primary' | 'secondary' | 'muted' | 'inherit';
}

const { 
  as: Tag = 'p', 
  variant = 'body', 
  color = 'primary',
  class: className, 
  ...props 
} = Astro.props;

const variantClasses = {
  h1: 'text-4xl font-extrabold tracking-tight lg:text-5xl font-sans',
  h2: 'text-3xl font-semibold tracking-tight font-sans',
  h3: 'text-2xl font-semibold tracking-tight font-sans',
  body: 'text-base leading-7',
  'body-sm': 'text-sm leading-6',
  muted: 'text-sm text-gray-500 dark:text-gray-400',
};

const colorClasses = {
  primary: 'text-gray-90',
  secondary: 'text-gray-600',
  muted: 'text-gray-500',
  inherit: '',
};

const classes = [
  variantClasses[variant],
  colorClasses[color],
  className
].filter(Boolean).join(' ');
---

<Tag class={classes} {...props}>
  <slot />
</Tag>
