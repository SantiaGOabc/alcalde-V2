---
import { Section, Tipography } from "@components";
import { Image } from "astro:assets";

const phraseImage =
  "https://manfredreyesvilla.netlify.app/_astro/DSC_0802_ZuLMnQ.webp";
---

<Section
  className="flex flex-col items-center gap-10 md:flex-row md:gap-12"
>
  <blockquote class="m-0 min-w-0 flex-1 text-center md:text-left">
    <Tipography
      as="p"
      class="text-balance text-2xl font-semibold leading-tight text-white sm:text-3xl lg:text-6xl"
    >
      “La vida es una sola y tienes que vivirla como si fuera el último día de
      tu vida.”
    </Tipography>
  </blockquote>
  <figure
    class="m-0 size-64 shrink-0 overflow-hidden rounded-full border-4 border-white/30 sm:size-72 lg:size-80"
  >
    {/* TODO: ACOMODAR CORRECTAMENTE EL CIRCULO Y LA IMAGEN INTERNA - la imagen será png transparente y se saldrá del circulo */}
    <Image
      src={phraseImage}
      alt="Retrato que acompaña la cita sobre vivir cada día plenamente"
      width={1200}
      height={1200}
      class="object-cover object-bottom"
    />
  </figure>
</Section>
