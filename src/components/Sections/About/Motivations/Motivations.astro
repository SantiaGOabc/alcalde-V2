---
import { Section, Tipography } from "@components";
import { MOTIVACIONES, SECTION_MOTIVATIONS } from "@constant";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const { kicker, titulo, descripcion } = SECTION_MOTIVATIONS;

const tarjetasRegulares = MOTIVACIONES.filter((item) => !item.destacada);
const tarjetaFamiliar = MOTIVACIONES.find((item) => item.destacada);
---

<Section variant="secondary" className={`py-16 sm:py-20 lg:py-24 ${className}`}>
  <div class="page-container">
    <!-- Encabezado de la Sección -->
    <header class="mb-10 max-w-3xl sm:mb-12">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-(--brand-accent)">
        {kicker}
      </p>
      <Tipography
        as="h2"
        color="inherit"
        class="text-3xl font-bold leading-tight text-balance text-gray-900 sm:text-4xl lg:text-5xl"
      >
        {titulo}
      </Tipography>
      <Tipography
        as="p"
        color="inherit"
        class="mt-4 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg"
      >
        {descripcion}
      </Tipography>
    </header>

    <!-- Bento Grid Editorial -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {tarjetasRegulares.map((item) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-gray-200/80 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-gray-300 hover:shadow-xl">
          <!-- Contenedor de Imagen con Relación de Aspecto Fija -->
          <div class="relative aspect-16/10 w-full overflow-hidden bg-gray-100 sm:aspect-4/3">
            <img
              src={item.imagenSrc}
              alt={item.imagenAlt}
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-80" />
          </div>

          <!-- Contenido Editorial -->
          <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
            <div class="space-y-3">
              <h3 class="text-xl font-bold tracking-tight text-gray-900 transition-colors group-hover:text-(--brand-primary)">
                {item.titulo}
              </h3>
              <blockquote class="border-l-2 border-(--brand-accent) pl-3.5 text-sm font-medium italic text-gray-700">
                {item.cita}
              </blockquote>
            </div>

            <p class="mt-4 text-xs leading-relaxed text-gray-500 sm:text-sm">
              {item.descripcion}
            </p>
          </div>
        </article>
      ))}

      <!-- Tarjeta Panorámica Familiar (Ancho Completo de Cierre) -->
      {tarjetaFamiliar && (
        <article class="group relative col-span-1 overflow-hidden rounded-3xl border border-purple-900/20 bg-linear-to-br from-[#2a174f] via-[#472D82] to-[#1c1038] text-white shadow-xl transition-all duration-300 hover:shadow-2xl sm:col-span-2 lg:col-span-3">
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <!-- Imagen Panorámica Familiar -->
            <div class="relative h-72 sm:h-96 lg:col-span-7 lg:h-auto min-h-[22rem] overflow-hidden">
              <img
                src={tarjetaFamiliar.imagenSrc}
                alt={tarjetaFamiliar.imagenAlt}
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-[#2a174f] via-transparent to-transparent lg:hidden" />
              <div class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-transparent via-transparent to-[#472D82]/90 lg:block" />
            </div>

            <!-- Contenido Emocional Familiar -->
            <div class="flex flex-col justify-center p-7 sm:p-10 lg:col-span-5 lg:p-12">
              <div class="space-y-4">
                <h3 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl lg:text-4xl">
                  {tarjetaFamiliar.titulo}
                </h3>

                <blockquote class="border-l-3 border-amber-400 pl-4 py-1 text-base sm:text-lg font-medium italic text-purple-100">
                  {tarjetaFamiliar.cita}
                </blockquote>

                <p class="text-sm leading-relaxed text-purple-200/90 sm:text-base">
                  {tarjetaFamiliar.descripcion}
                </p>
              </div>
            </div>
          </div>
        </article>
      )}
    </div>
  </div>
</Section>
