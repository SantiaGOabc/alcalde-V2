---
import MainLayout from "../../layouts/MainLayout.astro";
import { Section, Tipography, Button } from "@components";
---

<MainLayout title="Panel de Administración">
  <Section variant="secondary" className="px-4 py-24 sm:py-28 min-h-[calc(100vh-80px)] bg-slate-50 flex items-center justify-center">
    <div class="page-container max-w-3xl w-full">
      <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-xl border border-slate-200/80">
        <!-- Cabecera del Panel -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
          <div>
            <Tipography as="h1" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
              Panel Administrativo
            </Tipography>
          </div>

          <button
            id="btn-logout"
            type="button"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full text-xs font-bold text-red-700 bg-red-50 border border-red-200 hover:bg-red-100 transition-colors self-start sm:self-auto cursor-pointer"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar Sesión
          </button>
        </div>

        <!-- Información de Sesión y Accesos Rápidos -->
        <div class="mt-8 space-y-6">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/60 flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Usuario Autenticado</p>
              <p id="user-display" class="text-base font-bold text-slate-800 mt-0.5">admin@cochabamba.bo</p>
              <p class="text-xs text-slate-500">Rol: Administrador General del Sistema</p>
            </div>
            <span class="px-3 py-1 rounded-lg bg-white border border-slate-200 text-xs font-mono text-slate-600">
              Modo Mock Local
            </span>
          </div>

          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-3">
              Módulos Disponibles para Gestión
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a
                href="/about"
                class="p-4 rounded-xl border border-slate-200 hover:border-(--brand-primary) bg-white hover:bg-slate-50/50 transition-all flex flex-col gap-1 text-slate-700 hover:text-(--brand-primary)"
              >
                <span class="text-xs font-bold uppercase tracking-wide">CMS</span>
                <span class="text-xs text-slate-500">Editor de Contenido</span>
              </a>
              <a
                href="/mailbox"
                class="p-4 rounded-xl border border-slate-200 hover:border-(--brand-primary) bg-white hover:bg-slate-50/50 transition-all flex flex-col gap-1 text-slate-700 hover:text-(--brand-primary)"
              >
                <span class="text-xs font-bold uppercase tracking-wide">Buzón</span>
                <span class="text-xs text-slate-500">Mensajes Ciudadanos</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <script>
    import { getAuthSession, logoutService } from "@utils";

    const session = getAuthSession();
    const userDisplay = document.getElementById("user-display");
    const btnLogout = document.getElementById("btn-logout");

    if (session && userDisplay) {
      userDisplay.textContent = session.user.username;
    }

    btnLogout?.addEventListener("click", () => {
      logoutService();
      window.location.href = "/admin/login";
    });
  </script>
</MainLayout>
