---
import { youtubeId } from "@utils";

interface Props {
  src: string;
  type?: string;
  poster?: string;
  title?: string;
  class?: string;
}

const {
  src,
  type,
  poster,
  title = "Video",
  class: className,
} = Astro.props;

const id = youtubeId(src);
---

<div
  class:list={[
    "relative aspect-16/10 w-full overflow-hidden rounded-3xl bg-black",
    className,
  ]}
>
  {
    id ? (
      <lite-youtube
        videoid={id}
        nocookie
        videoplay="Reproducir"
        videotitle={title}
        params="rel=0"
        class="absolute inset-0 h-full w-full"
        style="--lite-youtube-aspect-ratio: 16 / 10"
      >
        {poster && (
          <img slot="image" src={poster} alt="" loading="lazy" decoding="async" />
        )}
      </lite-youtube>
    ) : (
      <video
        class="block aspect-16/10 w-full object-cover"
        controls
        playsinline
        preload="metadata"
        poster={poster}
      >
        <source src={src} type={type} />
        Your browser does not support the video tag.
      </video>
    )
  }
</div>

<script>
  // The library calls `customElements.define` on import and has no server
  // guard, so it is only pulled in from here, in the browser.
  import "@justinribeiro/lite-youtube";
</script>
