---
import { Image } from "astro:assets";
import { Section, Tipography } from "@components";
import { LOGIN_CONTENT } from "@constant";
import LoginForm from "./LoginForm.tsx";

interface Props {
  /** Código secreto de la URL /admin/<code>. */
  code: string;
}

const { code } = Astro.props;
const { title, subtitle, description, imageURL, imageAlt } = LOGIN_CONTENT;
---

<Section variant="secondary" className="pt-20 pb-12 sm:pt-24 sm:pb-16 flex justify-center items-center min-h-[calc(100vh-80px)] bg-slate-100">
  <div class="w-full max-w-5xl bg-white rounded-[2rem] p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] border border-slate-100">
    <!-- Columna Izquierda: Formulario -->
    <div class="w-full lg:w-[55%] flex flex-col justify-center">
      <header class="mb-6">
        <Tipography as="h1" variant="h2" class="text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900">
          {title}
        </Tipography>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mt-1">
          {subtitle}
        </p>
        <Tipography as="p" variant="body" class="mt-2 text-sm text-slate-600 max-w-sm">
          {description}
        </Tipography>
      </header>

      <LoginForm client:load code={code} />
    </div>

    <!-- Columna Derecha: Imagen Institucional Split-Card -->
    <div class="w-full lg:w-[45%] flex items-center justify-center">
      <div class="relative w-full rounded-[1.5rem] overflow-hidden shadow-sm aspect-4/5 lg:aspect-auto lg:h-[540px] max-h-[540px] bg-slate-900">
        <Image 
          src={imageURL} 
          alt={imageAlt}
          width={600}
          height={800}
          class="absolute inset-0 size-full object-cover transition-transform duration-700 hover:scale-105"
        />
        <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-slate-950/85 via-slate-950/20 to-transparent flex flex-col justify-end p-6 sm:p-8 text-white">
          <p class="mt-1 text-base font-semibold leading-snug text-white">
            Administración
          </p>
          <p class="mt-1 text-xs text-white/70">
            Gobierno Autónomo Municipal
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
