---
import { Button, Section, Tipography } from "@components";
import { BookPages, ClosedBook, FlipbookOverlay } from "./Book";
import "@styles/flipbook.css";

/**
 * La tarjeta del libro.
 *
 * Conserva el texto y el botón que ya había, y añade el libro en 3D, las
 * hojas y el visor. El botón de siempre y el propio libro cerrado comparten el
 * disparador `data-book-open`, así que se abre desde cualquiera de los dos.
 *
 * La foto de la tarjeta era la misma que hoy es la tapa del libro, y por eso
 * la reemplaza el 3D en lugar de convivir con ella. Esa imagen sigue llegando
 * por `SECTION_BOOK_CONTENT` y la usa `BOOK_META`, que es de donde el libro
 * cerrado y la primera hoja sacan su portada.
 */
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  button: string;
}

const { title, eyebrow, description, button } = Astro.props;
---

<Section
  variant="secondary"
  data-book
  className="overflow-hidden py-24 sm:py-32 lg:py-40"
>
  <div
    class="page-container grid items-center gap-16 lg:grid-cols-2 lg:gap-20"
  >
    <div class="relative z-10">
      <Tipography
        as="span"
        color="inherit"
        class="inline-flex items-center gap-3 text-xs font-semibold uppercase text-(--home-accent) sm:text-sm"
      >
        <span aria-hidden="true" class="h-px w-8 bg-(--home-accent)"></span>
        {eyebrow}
      </Tipography>

      <Tipography
        as="h2"
        variant="h2"
        class="mt-7 max-w-xl text-5xl font-semibold leading-[0.98] text-balance sm:text-6xl lg:text-7xl"
      >
        {title}
      </Tipography>

      <Tipography
        as="p"
        color="secondary"
        class="mt-7 max-w-lg text-lg leading-8 text-pretty sm:text-xl"
      >
        {description}
      </Tipography>

      <Button
        text={button}
        className="mt-8 min-h-12 rounded-full bg-(--home-accent) px-6 text-gray-200"
        aria-label={button}
        data-book-open
      />
    </div>

    <div class="relative mx-auto flex w-full max-w-120 items-center justify-center px-5 sm:px-10">
      <!-- Telón de fondo del libro. Va en degradado y redondeado a propósito: un
           rectángulo de color plano compite con la silueta del libro y rompe la
           composición; así se lee como un panel y no como una pieza más. -->
      <div
        aria-hidden="true"
        class="absolute inset-y-2 right-2 w-[86%] rounded-3xl"
      >
      </div>
      <ClosedBook label={button} />
    </div>
  </div>

  <!-- El libro entero, escrito en el servidor. Se queda escondido hasta que el
       visor abre: su destino es el marco, no esta página. -->
  <BookPages />
  <FlipbookOverlay />
</Section>

<script>
  // Directo al módulo y no por el barril: el barril también reexporta
  // componentes `.astro`, y arrastrarlos al cliente intentaría compilar
  // `astro:assets` en el navegador.
  import { onPageLoad } from "@utils";
  import { createBookViewer } from "./Book/createBookViewer";

  // Un visor por página; al salir se le quitan los oyentes globales (teclado, resize).
  onPageLoad(() => {
    const viewer = createBookViewer(document);
    return () => viewer?.destroy();
  });
</script>
