{
  "name": "c-users-usuario-desktop-alcalde-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "limpieza": "node -e \"for (const d of ['node_modules/.vite','node_modules/.astro','.astro','dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "dev": "npm run limpieza && astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:up": "docker compose up -d db",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "docker:up": "docker compose up --build",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "page-flip": "^2.0.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
