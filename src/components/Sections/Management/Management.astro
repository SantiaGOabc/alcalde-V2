---
import { Section, Tipography } from "@components";

interface Props {
  title: string;
  description: string;
  variant?: "primary" | "secondary" | "accent";
}

const { title, description, variant = "primary" } = Astro.props;
---

<Section variant={variant} className="py-16 sm:py-20 lg:py-24">
  <div class="page-container">
    <header class="max-w-3xl">
      <Tipography
        as="h1"
        color="inherit"
        class="text-3xl font-semibold leading-tight text-balance text-gray-900 sm:text-4xl lg:text-5xl"
      >
        {title}
      </Tipography>
      <Tipography
        as="p"
        color="inherit"
        class="mt-4 max-w-2xl text-base leading-7 text-gray-600 text-pretty sm:text-lg"
      >
        {description}
      </Tipography>
    </header>

    <slot />
  </div>
</Section>
