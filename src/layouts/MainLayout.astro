---
import Navbar from '../global/navbar.astro';
import Footer from '../global/footer.astro';
import '../styles/global.css';

const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content="Alcaldía V2" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-gray-900">
		<Navbar />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
