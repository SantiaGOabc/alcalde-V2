---
import MainLayout from "@layouts/MainLayout.astro";
import { Hero, BiographyVideo, Phrase, BeforeAfter, Book } from "@components";
import {
  CONTENT_HERO_HOME,
  SECTION_PHRASES_CONTENT,
  SECTION_BIOGRAPHY_CONTENT,
  SECTION_BEFORE_AFTER_CONTENT,

} from "@constant";
import "@styles/home.css";

const phrases = Object.entries(SECTION_PHRASES_CONTENT).map(
  ([, content], position) => {
    const variant: "primary" | "secondary" =
      position % 2 === 0 ? "secondary" : "primary";

    return {
      ...content,
      lead: position === 0,
      reverse: position % 2 === 1,
      variant,
    };
  },
);
---

<MainLayout title="Inicio">
  <Hero
    title={CONTENT_HERO_HOME.title}
    description={CONTENT_HERO_HOME.description}
    images={CONTENT_HERO_HOME.images}
  />
  <BiographyVideo 
    title={SECTION_BIOGRAPHY_CONTENT.title}
    description={SECTION_BIOGRAPHY_CONTENT.description}
    buttons={SECTION_BIOGRAPHY_CONTENT.buttons}
    video={SECTION_BIOGRAPHY_CONTENT.video}
  />

  <div class="phrase-slider" style={`--items: ${phrases.length}`}>
    {
      phrases.map((phrase, index) => (
        <Phrase
          phrase={phrase.phrase}
          imageURL={phrase.imageURL}
          lead={phrase.lead}
          index={index}
          reverse={phrase.reverse}
          variant={phrase.variant}
        />
      ))
    }
  </div>
  <BeforeAfter 
    title={SECTION_BEFORE_AFTER_CONTENT.title}
    description={SECTION_BEFORE_AFTER_CONTENT.description}
    before={SECTION_BEFORE_AFTER_CONTENT.before}
    after={SECTION_BEFORE_AFTER_CONTENT.after}
  />
  <Book/>
</MainLayout>

<script>
  import { bindScrollProgress, $ } from "@utils";

  const slider = $(".phrase-slider") as HTMLElement;
  if(slider) 
    bindScrollProgress({ target: slider });
</script>
