---
import { Form, FormField, Input, Section, Select, Textarea, Tipography, SafeImage } from "@components";
import { MAILBOX_MESSAGE_TYPES } from "@constant";
import { sectionId } from "@/cms/anchors";
import { getContent } from "@/lib/server";

const { title, description, imageURL, imageAlt, form } = await getContent("mailbox");
---

<Section id={sectionId("mailbox")} variant="secondary" className="pt-20 pb-12 sm:pt-24 sm:pb-16 flex justify-center items-center min-h-[calc(100vh-80px)] bg-slate-100">
  <div class="w-full max-w-5xl bg-white rounded-[2rem] p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)]">
    <div class="w-full lg:w-[55%] flex flex-col justify-center">
      <header class="mb-6">
        <Tipography as="h2" variant="h2" class="text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900">
          {title}
        </Tipography>
        <Tipography as="p" variant="body" class="mt-2 text-sm text-slate-600 max-w-sm">
          {description}
        </Tipography>
      </header>

      <Form
        service="mailbox"
        submitText={form.submitButton}
        loadingText={form.loadingText}
        cancelText={form.cancelButton}
        successTitle={form.successTitle}
        successMessage={form.successMessage}
        errorTitle={form.errorTitle}
        errorMessage={form.errorMessage}
        class="flex flex-col gap-4 w-full"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <FormField id="fullName" label={form.fullNameLabel}>
            <Input variant="field" id="fullName" name="fullName" type="text" placeholder={form.fullNamePlaceholder} required />
          </FormField>
          <FormField id="email" label={form.emailLabel}>
            <Input variant="field" id="email" name="email" type="email" placeholder={form.emailPlaceholder} required />
          </FormField>
        </div>

        <FormField id="type" label={form.typeLabel}>
          <Select id="type" name="type" options={MAILBOX_MESSAGE_TYPES} placeholder={form.typePlaceholder} required />
        </FormField>

        <FormField id="message" label={form.messageLabel}>
          <Textarea id="message" name="message" class="h-24" required />
        </FormField>
      </Form>
    </div>

    <div class="w-full lg:w-[45%] flex items-center justify-center">
      <div class="relative w-full rounded-[1.5rem] overflow-hidden shadow-sm aspect-4/5 lg:aspect-auto lg:h-[520px] max-h-[520px]">
        <SafeImage 
          src={imageURL} 
          alt={imageAlt}
          width={600}
          height={800}
          class="absolute inset-0 size-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
    </div>
  </div>
</Section>
