---
import { Link, Button } from "@components";
import { NAVBAR } from "@constant";
// `--home-accent` vive aquí, y el navbar lo necesita en todas las páginas.
import "@styles/home.css";

interface Props {
  /** Sobre un hero: sin fondo hasta hacer scroll. Si no, sólido desde el inicio. */
  transparent?: boolean;
  /** El Home es la sección con efecto de cristal; si no se dice, se deduce de `transparent`. */
  isHome?: boolean;
  /** Ruta del panel; solo llega cuando quien mira es el administrador con sesión. */
  adminHref?: string | null;
}

const { transparent = false, isHome = transparent, adminHref = null } = Astro.props;
// La ruta se compara sin barra final para que `/` y la home sean el mismo enlace.
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);

const links = [
  ...NAVBAR.map((link) => ({ ...link, isAdmin: false })),
  ...(adminHref ? [{ path: adminHref, label: "Panel", isAdmin: true }] : []),
].map((link) => ({ ...link, isActive: normalize(link.path) === currentPath }));
---

<nav
  id="site-navbar"
  data-navbar-glass={isHome ? "true" : "false"}
  aria-label="Navegación principal"
  data-transparent={transparent}
  data-solid={!transparent}
  data-menu-open="false"
  class="group fixed top-0 z-50 w-full border-b border-transparent text-white transition-[background-color,box-shadow] duration-300 data-[solid=true]:bg-(--home-accent) data-[solid=true]:border-white/10 data-[solid=true]:shadow-md"
>
  <div class="page-container flex h-16 items-center justify-between">
    <Link
      href="/"
      class="text-xl font-bold tracking-tight text-white no-underline before:hidden after:hidden transition-transform hover:scale-105"
    >
      M<span class="text-indigo-300">.</span>R<span class="text-indigo-300">.</span>V
  </Link>

    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map((nav) => (
          <li>
            <Link
              href={nav.path}
              aria-current={nav.isActive ? "page" : undefined}
              class:list={[
                "border-b-2 border-transparent pb-0.5 text-lg font-semibold text-white/80 no-underline transition-colors before:hidden after:hidden hover:border-white/50 hover:text-white aria-[current=page]:border-white aria-[current=page]:text-white",
                nav.isAdmin && "rounded-full border-2 border-white/60 px-4 py-1 hover:border-white",
              ]}
            >
              {nav.label}
            </Link>
          </li>
        ))
      }
    </ul>

    <Button
      variant="ghost"
      id="menu-toggle"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
      className="relative grid size-10 place-items-center md:hidden"
    >
      <span
        aria-hidden="true"
        class="absolute h-0.5 w-6 -translate-y-2 rounded-full bg-white transition-transform duration-300 group-data-[menu-open=true]:translate-y-0 group-data-[menu-open=true]:rotate-45"
      ></span>
      <span
        aria-hidden="true"
        class="absolute h-0.5 w-6 rounded-full bg-white transition-opacity duration-200 group-data-[menu-open=true]:opacity-0"
      ></span>
      <span
        aria-hidden="true"
        class="absolute h-0.5 w-6 translate-y-2 rounded-full bg-white transition-transform duration-300 group-data-[menu-open=true]:translate-y-0 group-data-[menu-open=true]:-rotate-45"
      ></span>
  </Button>
  </div>
</nav>

<!--
  El menú móvil es hermano del <nav>, no hijo: un `backdrop-filter` en el
  padre lo volvería contenedor de los `fixed` y el overlay dejaría de cubrir
  toda la pantalla. Queda por debajo (z-40) para que el botón siga visible.
-->
<div
  id="mobile-menu"
  data-open="false"
  inert
  class="group/menu invisible fixed inset-0 z-40 flex items-center justify-center bg-(--home-accent) opacity-0 transition-[opacity,visibility] duration-300 data-[open=true]:visible data-[open=true]:opacity-100 md:hidden"
>
  <ul class="flex flex-col items-center gap-8 text-center">
    {
      links.map((nav, index) => (
        <li
          style={`--delay: ${index * 70 + 100}ms`}
          class="translate-y-6 opacity-0 transition-[opacity,transform] duration-500 group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:delay-(--delay)"
        >
          <Link
            href={nav.path}
            aria-current={nav.isActive ? "page" : undefined}
            class="text-3xl font-semibold text-white/75 no-underline transition-colors hover:text-white aria-[current=page]:text-white"
          >
            {nav.label}
          </Link>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { initNavbar, onPageLoad } from "@utils";

  // `initNavbar` pasa de transparente a sólido al hacer scroll y mueve el menú móvil.
  onPageLoad(initNavbar);
</script>
