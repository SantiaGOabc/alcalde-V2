---
import {
  ComparisonSlide,
  Input,
  InterludeSlide,
  MayorSlide,
  Section,
  SlideNav,
  Tipography,
  buildSlides,
} from "@components";
import type { ComparacionImagen } from "@types";

interface Props {
  title: string;
  description: string;
  transitionPhrase: string;
  before: ReadonlyArray<ComparacionImagen>;
  after: ReadonlyArray<ComparacionImagen>;
}

const { title, description, transitionPhrase, before, after } = Astro.props;

const slides = buildSlides(before, after, transitionPhrase);

// Los dibujos que se comprueban uno a uno, en orden; el que sobra, la
// comparación, es el que se dibuja si no es ninguno de los dos. El `as const` no
// es decorativo: es lo que deja cada elemento con su tipo literal, y con él lo
// que permite que TypeScript sepa qué diapositiva es cuál al preguntar por el
// `kind`.
const optionsSlide = ["interlude", "mayor"] as const;
---

<Section className="py-16 sm:py-20 lg:py-24">
  <div class="page-container">
    <header class="mb-8 max-w-3xl sm:mb-10">
      <Tipography
        as="h3"
        class="mt-3 text-3xl font-semibold leading-tight text-balance sm:text-4xl lg:text-5xl"
      >
        {title}
      </Tipography>
      <Tipography
        as="p"
        class="mt-4 max-w-2xl text-base leading-7 text-gray-600 sm:text-lg"
      >
        {description}
      </Tipography>
    </header>

    {
      slides.length > 0 && (
        /* La tarjeta es el alcance del script, y por eso la banda de
           navegación puede vivir debajo del escenario sin quedarse fuera. */
        <div
          class="overflow-hidden rounded-brand bg-white text-white shadow-xl"
          data-before-after-slider
        >
          <div
            class="relative aspect-4/3 max-h-[calc(100svh-9rem)] min-h-96 w-full overflow-hidden bg-gray-900 sm:aspect-video"
            data-before-after-stage
          >
            {
              slides.map((slide, index) =>
                slide.kind === optionsSlide[0] ? (
                  <InterludeSlide text={slide.text} active={index === 0} />
                ) : slide.kind === optionsSlide[1] ? (
                  <MayorSlide comparison={slide} active={index === 0} />
                ) : (
                  <ComparisonSlide comparison={slide} active={index === 0} />
                ),
              )
            }

            <Input
              type="range"
              min="0"
              max="100"
              value="50"
              aria-label="Desliza horizontalmente para comparar el antes y el después"
              aria-valuetext="50% después"
              class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              data-comparison-range
            />
          </div>

          <SlideNav total={slides.length} />
        </div>
      )
    }
  </div>
</Section>

<script>
  import { onPageLoad } from "@utils";
  import { initBeforeAfterSliders } from "./BeforeAfter/beforeAfterSlider";

  onPageLoad(initBeforeAfterSliders);
</script>