---
/**
 * Visor de Gestión — VARIANTE EDITORIAL (la propuesta anterior).
 *
 * Índice de áreas a la izquierda, ficha de la obra a la derecha y esquinas
 * rectas, con filetes finos. No es la isla que se renderiza hoy — esa es
 * `../ProjectsViewer`, la tarjeta violeta.
 *
 * Se conserva entera para poder volver a ella: en `Management.astro` basta
 * cambiar el import (y el CSS sigue importado, así que no hay nada más que tocar).
 */
import type { Obra } from '@constant';
import { prepararCategorias } from '../visorObrasData';
import { ProjectsViewer as ProjectsViewerIsland } from './index';

interface Props {
  /** Obras ya publicadas (de la base de datos o, en su defecto, de los constants). */
  obras: Obra[];
}

const { obras } = Astro.props;

const categorias = await prepararCategorias(obras);
---

<ProjectsViewerIsland client:visible categorias={categorias} />
