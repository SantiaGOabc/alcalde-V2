---
import MailBoxForm from './MailBoxForm.tsx';
import { Image } from "astro:assets";
---

<section class="bg-slate-50 px-4 py-12 sm:px-6 lg:px-8 flex justify-center items-center min-h-[90vh]">
  <div class="w-full max-w-6xl bg-white rounded-3xl border border-slate-100 overflow-hidden flex flex-col lg:flex-row shadow-2xl shadow-slate-200/60 hover:-translate-y-2 hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.1)] transition-all duration-500 ease-out">
    <div class="w-full lg:w-1/2 relative min-h-[300px] lg:min-h-full flex flex-col justify-end">
      <Image 
        src="https://cochabamba.bo/img/noticias/XApapGO21aPYGwIPs14pbmNwTikKkRsK4Ywgh7qm.jpeg" 
        alt="Buzon Ciudadano"
        width={1000}
        height={1000}
        class="absolute inset-0 size-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
      <div class="relative z-10 p-10 sm:p-14">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          Buzón Ciudadano
        </h2>
      </div>
    </div>
    <!-- COLUMNA DERECHA-->
    <div class="w-full lg:w-1/2 bg-white p-10 sm:p-14 flex items-center">
      <MailBoxForm client:visible />
    </div>

  </div>
</section>