---
import type { HTMLAttributes } from "astro/types";
import { FIELD_CLASS } from "./fieldStyles";

export interface SelectOption {
  value: string;
  label: string;
}

interface Props extends HTMLAttributes<"select"> {
  options: readonly SelectOption[];
  /** Opción inicial deshabilitada; obliga al usuario a elegir si el campo es `required`. */
  placeholder?: string;
}

const { options, placeholder, class: className, ...props } = Astro.props;
---

<div class="relative">
  <select class:list={[FIELD_CLASS, "appearance-none pr-10 invalid:text-slate-400", className]} {...props}>
    {placeholder && <option value="" disabled selected hidden>{placeholder}</option>}
    {options.map(({ value, label }) => <option value={value} class="text-slate-900">{label}</option>)}
  </select>
  <svg
    aria-hidden="true"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-slate-500"
  >
    <path
      fill-rule="evenodd"
      d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z"
      clip-rule="evenodd"></path>
  </svg>
</div>
