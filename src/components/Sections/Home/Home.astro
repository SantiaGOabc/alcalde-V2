---
import MainLayout from "@layouts/MainLayout.astro";
import { Hero, BiographyVideo, Phrase, BeforeAfter, Book, TikTokFeed } from "@components";
import { sectionId } from "@/cms/anchors";
import { getContent } from "@/lib/server";
import "@styles/home.css";

const [hero, biography, phrasesContent, beforeAfter, book, tiktok] = await Promise.all([
  getContent("home.hero"),
  getContent("home.biography"),
  getContent("home.phrases"),
  getContent("home.beforeAfter"),
  getContent("home.book"),
  getContent("home.tiktok"),
]);

const phrases = Object.entries(phrasesContent).map(
  ([, content], position) => {
    const variant: "primary" | "secondary" =
      position % 2 === 0 ? "secondary" : "primary";

    return {
      ...content,
      lead: position === 0,
      reverse: position % 2 === 1,
      variant,
    };
  },
);
---

<MainLayout title="Inicio" transparentNavbar>
  <Hero
    id={sectionId("home.hero")}
    title={hero.title}
    description={hero.description}
    images={hero.images}
  />
  <div id={sectionId("home.biography")}>
    <BiographyVideo
      title={biography.title}
      description={biography.description}
      buttons={biography.buttons}
      video={biography.video}
    />
  </div>

  <div id={sectionId("home.phrases")} class="phrase-slider" style={`--items: ${phrases.length}`}>
    {
      phrases.map((phrase, index) => (
        <Phrase
          phrase={phrase.phrase}
          imageURL={phrase.imageURL}
          lead={phrase.lead}
          index={index}
          reverse={phrase.reverse}
          variant={phrase.variant}
        />
      ))
    }
  </div>
  <div id={sectionId("home.beforeAfter")}>
    <BeforeAfter
      title={beforeAfter.title}
      description={beforeAfter.description}
      transitionPhrase={beforeAfter.transitionPhrase}
      before={beforeAfter.before}
      after={beforeAfter.after}
    />
  </div>
  <div id={sectionId("home.book")}>
    <Book
      title={book.title}
      eyebrow={book.eyebrow}
      description={book.description}
      button={book.button}
    />
  </div>
  <div id={sectionId("home.tiktok")}>
    <TikTokFeed/>
  </div>
</MainLayout>

<script>
  import { $, bindScrollProgress, onPageLoad } from "@utils";

  onPageLoad(() => bindScrollProgress({ target: $(".phrase-slider") }));
</script>
